# Generated by Preflight {{ version }} -- read it, then deploy it. Regenerate
# rather than editing by hand:
#
#   {{ regenerate_command }}
#
# Modules covered:
{% for module in modules %}
#   - {{ module.name }} ({{ module.key }}), {{ module.count }} actions
{% endfor %}
{% if selected_services %}
# Narrowed at generation time to these services:
#   {{ selected_services | join(", ") }}
{% endif %}
# Always included:
{% for action in base_actions %}
#   - {{ action }}, so Preflight can show you which account it is reading
{% endfor %}
#
# {{ actions | length }} read-only actions in total -- no write actions and no
# wildcards. Every action below is one a check you selected actually calls.
AWSTemplateFormatVersion: "2010-09-09"
Description: >
  Dedicated read-only IAM role for Jet1 Preflight ({{ module_names }}). Creates a
  role that can be assumed (optionally cross-account) with only the actions the
  selected Preflight modules declare -- no write or wildcard actions. Safe to
  deploy once and reuse for every Preflight scan.

Parameters:
  TrustedPrincipalArn:
    Type: String
    Description: >
      ARN of the IAM user/role that will assume this role to run Preflight.
      Use your own account's user/role ARN for same-account use, or an
      external account's ARN only if you intend cross-account access.
  ExternalId:
    Type: String
    Default: ""
    Description: >
      Optional external ID to require on AssumeRole, recommended for
      cross-account trust relationships.
    NoEcho: true

Conditions:
  HasExternalId: !Not [!Equals [!Ref ExternalId, ""]]

Resources:
  PreflightReadOnlyPolicy:
    Type: AWS::IAM::ManagedPolicy
    Properties:
      ManagedPolicyName: {{ policy_name }}
      Description: Read-only permissions used by Jet1 Preflight. Get*/List*/Describe* only.
      PolicyDocument:
        Version: "2012-10-17"
        Statement:
          - Sid: PreflightReadOnly
            Effect: Allow
            Action:
{% for action in actions %}
              - {{ action }}
{% endfor %}
            Resource: "*"

  PreflightReadOnlyRole:
    Type: AWS::IAM::Role
    Properties:
      RoleName: {{ role_name }}
      Description: Role assumed by Jet1 Preflight to run a read-only AWS audit.
      MaxSessionDuration: 3600
      AssumeRolePolicyDocument:
        Version: "2012-10-17"
        Statement:
          - Effect: Allow
            Principal:
              AWS: !Ref TrustedPrincipalArn
            Action: sts:AssumeRole
            Condition: !If
              - HasExternalId
              - StringEquals:
                  sts:ExternalId: !Ref ExternalId
              - !Ref AWS::NoValue
      ManagedPolicyArns:
        - !Ref PreflightReadOnlyPolicy

Outputs:
  RoleArn:
    Description: ARN to pass to `preflight scan --role-arn`
    Value: !GetAtt PreflightReadOnlyRole.Arn
